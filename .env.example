NODE_ENV=development
RELEASE_VERSION=development
LOG_LEVEL=info
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
METRICS_ENABLED=false

WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=3002
API_BASE_URL=http://localhost:3002
API_PREFIX=api
API_VERSION=v1
API_SWAGGER_ENABLED=true
API_BODY_LIMIT_BYTES=1048576
API_MAX_QUERY_LENGTH=2048
HEALTH_DEPENDENCY_TIMEOUT_MS=1000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002/api/v1
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
NEXT_PUBLIC_PWA_ENABLED=false
NEXT_PUBLIC_PWA_TEST_MODE=false
NEXT_PUBLIC_CLIENT_OBSERVABILITY_ENABLED=false
NEXT_PUBLIC_CLIENT_OBSERVABILITY_ENDPOINT=/api/observability/client
NEXT_PUBLIC_ENABLE_UI_CATALOG=false
NEXT_PUBLIC_GUEST_LOCATION_PREVIEW_ENABLED=false
NEXT_PUBLIC_GUEST_LOCATION_PREVIEW_LATITUDE=-6.1468
NEXT_PUBLIC_GUEST_LOCATION_PREVIEW_LONGITUDE=106.8061
NEXT_PUBLIC_GUEST_LOCATION_PREVIEW_LABEL=Tambora, Jakarta Barat
NEXT_PUBLIC_MAP_TILES_DISABLED=false
NEXT_PUBLIC_MAP_TILE_ORIGINS=https://a.tile.openstreetmap.org,https://b.tile.openstreetmap.org,https://c.tile.openstreetmap.org

MYSQL_DATABASE=pitstop
MYSQL_USER=pitstop
MYSQL_PASSWORD=pitstop_local_change_me
MYSQL_ROOT_PASSWORD=pitstop_root_local_change_me
DATABASE_URL=mysql://pitstop:pitstop_local_change_me@localhost:3306/pitstop

REDIS_URL=redis://localhost:6379
GOOGLE_FORM_SOURCE_ID=google-form-main
GOOGLE_FORM_SOURCE_ENABLED=true
GOOGLE_FORM_CURRENT_KEY_ID=local-v1
GOOGLE_FORM_CURRENT_SECRET=local-google-form-secret-change-me-0123456789
# Set both during a bounded rotation window, then remove both.
# GOOGLE_FORM_PREVIOUS_KEY_ID=local-v0
# GOOGLE_FORM_PREVIOUS_SECRET=local-previous-google-form-secret-change-me
GOOGLE_FORM_REPLAY_WINDOW_SECONDS=300
GOOGLE_FORM_RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_FORM_RATE_LIMIT_MAX=120
GOOGLE_FORM_BODY_LIMIT_BYTES=131072
WORKER_RECONCILE_INTERVAL_MS=5000
WORKER_STAGE_LEASE_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_TTL_SECONDS=30
GEOCODING_PROVIDER=deterministic
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=PitStop-local/1.0
GEOCODING_HTTP_TIMEOUT_MS=30000
GEOCODING_CONFIDENCE_THRESHOLD=0.7
DUPLICATE_RADIUS_METERS=250
REDIS_CACHE_ENABLED=true
CACHE_CATEGORIES_TTL_SECONDS=300
CACHE_PLACE_DETAIL_TTL_SECONDS=60
CACHE_SEARCH_TTL_SECONDS=30
CACHE_RECOMMENDATION_TTL_SECONDS=30
CACHE_REDIS_TIMEOUT_MS=250

PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX=60
RECOMMENDATION_RATE_LIMIT_MAX=30
AUTH_MAGIC_LINK_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REQUEST_IP_MAX=10
AUTH_REQUEST_EMAIL_MAX=3
AUTH_REQUEST_GLOBAL_MAX=500
AUTH_VERIFY_IP_MAX=30
AUTH_VERIFY_GLOBAL_MAX=1000
CONTRIBUTION_RATE_LIMIT_WINDOW_SECONDS=60
CONTRIBUTION_RATE_LIMIT_MAX=30
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_READ_RATE_LIMIT_MAX=240
ADMIN_MUTATION_RATE_LIMIT_MAX=60
# Required in production; use distinct, random values of at least 32 UTF-8 bytes.
# AUTH_TOKEN_SECRET=replace-with-a-unique-production-token-secret
# AUTH_SESSION_SECRET=replace-with-a-unique-production-session-secret
AUTH_COOKIE_SECURE=false
PUBLIC_FALLBACK_RADIUS_METERS=10000
PUBLIC_MAX_SEARCH_LIMIT=50
PUBLIC_RECOMMENDATION_CANDIDATE_LIMIT=200
# Required in production; use a unique value of at least 32 UTF-8 bytes. Omit in development to
# generate a process-local ephemeral secret, which invalidates cursors after restart.
# PUBLIC_CURSOR_SIGNING_SECRET=replace-with-a-unique-production-secret
PUBLIC_BUDGET_MAX_AMOUNT=10000000
PUBLIC_LOCATION_LOGGING=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pitstop-local
S3_ACCESS_KEY=pitstop-local
S3_SECRET_KEY=pitstop_minio_local_change_me
S3_FORCE_PATH_STYLE=true

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM_ADDRESS=noreply@pitstop.local
# MAIL_USER=
# MAIL_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
# Required with TRUST_PROXY=true; list only the directly trusted proxy IPs/CIDRs.
# TRUST_PROXY_CIDRS=10.0.0.0/24
