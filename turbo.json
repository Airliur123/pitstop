{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "RELEASE_VERSION",
    "WEB_BASE_URL",
    "ADMIN_BASE_URL",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_CLIENT_OBSERVABILITY_ENABLED",
    "NEXT_PUBLIC_CLIENT_OBSERVABILITY_ENDPOINT",
    "NEXT_PUBLIC_ENABLE_UI_CATALOG",
    "NEXT_PUBLIC_GUEST_LOCATION_PREVIEW_ENABLED",
    "NEXT_PUBLIC_GUEST_LOCATION_PREVIEW_LATITUDE",
    "NEXT_PUBLIC_GUEST_LOCATION_PREVIEW_LONGITUDE",
    "NEXT_PUBLIC_GUEST_LOCATION_PREVIEW_LABEL",
    "NEXT_PUBLIC_MAP_TILE_ORIGINS",
    "NEXT_PUBLIC_MAP_TILES_DISABLED",
    "NEXT_PUBLIC_PWA_ENABLED",
    "NEXT_PUBLIC_PWA_TEST_MODE",
    "PWA_TEST_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@pitstop/api#build": { "outputs": [] },
    "@pitstop/config#build": { "outputs": [] },
    "@pitstop/contracts#build": { "outputs": [] },
    "@pitstop/database#build": { "outputs": [] },
    "@pitstop/testing#build": { "outputs": [] },
    "@pitstop/ui#build": { "outputs": [] },
    "@pitstop/validation#build": { "outputs": [] },
    "@pitstop/worker#build": { "outputs": [] },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
